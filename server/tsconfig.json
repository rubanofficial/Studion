/**
 * Deliberately permissive TypeScript config for a plain-JavaScript server.
 *
 * The value here is not type safety — it is `checkJs`, which turns the JSDoc
 * annotations on the service layer into a real check that the shared domain core
 * is called with the shapes it expects. That is the one interface where a silent
 * mistake would corrupt analytics, so it is worth the noise elsewhere.
 */
{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023"],
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "strict": false,
    "noImplicitAny": false,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["src/**/*.js"],
  "exclude": ["node_modules", "src/scripts/**/*.js", "**/*.test.js"]
}
